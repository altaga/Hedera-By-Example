{
  "schemaVersion": "2024-11-05",
  "name": "hedera-by-example-mcp",
  "version": "2.0.0",
  "description": "Universal Model Context Protocol (MCP) server for Hedera hashgraph development",
  "author": "Hedera by Example",
  "repository": "https://github.com/altaga/Hedera-By-Example",
  "productionUrl": "https://hbe.expo.app",
  "transports": {
    "stdio": {
      "command": "node",
      "args": [
        "mcp/index.js"
      ],
      "note": "Run `npm install` inside mcp/ first."
    },
    "streamableHttp": {
      "endpoint": "https://hbe.expo.app/api/mcp",
      "protocols": [
        "2025-06-18",
        "2025-03-26",
        "2024-11-05"
      ]
    },
    "localHttp": {
      "endpoint": "http://localhost:3001/mcp",
      "sse": "http://localhost:3001/sse",
      "note": "Only when running mcp/index.js with the HTTP transport."
    },
    "tools": "https://hbe.expo.app/mcp/tools.json"
  },
  "capabilities": {
    "tools": true,
    "prompts": false,
    "resources": true
  }
}
