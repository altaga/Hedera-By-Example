# Port for HBE Faucet HTTP Server
PORT=3005

# Hedera Network
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Operator Treasury Account (fallback & pool re-stocking)
OPERATOR_ID=0.0.11296718
OPERATOR_KEY=your_operator_der_private_key_here

# Faucet Pool BIP-39 12-Word Mnemonic (derived wallets for round-robin)
FAUCET_MNEMONIC="your_12_word_mnemonic_here"
FAUCET_POOL_SIZE=25
TARGET_HBAR_PER_WALLET=100

# Optional Paid Enterprise RPC Fallbacks
VALIDATIONCLOUD_API_KEY=
HGRAPH_API_KEY=

# PostHog Analytics (for tracking faucet claim counts)
HOG_PROJECT_ID=396791
HOG_API_KEY=your_posthog_project_api_key_here
HOG_PERSONAL_API_KEY=your_posthog_personal_api_key_here
POSTHOG_DISABLED=false
# Hedera analytics schema v1 (see ANALYTICS_EVENTS.md). Where this server runs: production | preview
# (anything else, or unset, is development).
ANALYTICS_ENV=
# Requests with header x-hbe-test-key equal to this value are never sent to PostHog (test traffic).
HBE_TEST_API_KEY=
